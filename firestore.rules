rules_version = '2';

// Security rules for Mama Bunz' Shop.
// Paste these into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Everyone can see stock. The website may only LOWER it (when an order
    // is placed), by at most 20 at a time, and never below zero.
    // Mama Bunz restocks by editing the numbers in the Firebase console.
    match /products/{productId} {
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
        && request.resource.data.stock is number
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock
        && resource.data.stock - request.resource.data.stock <= 20;
      allow create, delete: if false;
    }

    // Visitors can create an order but never read, change or delete one.
    // Mama Bunz reads orders in the Firebase console.
    match /orders/{orderId} {
      allow create: if request.resource.data.number == orderId
        && request.resource.data.status == 'awaiting-payment'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 30
        && request.resource.data.total is number
        && request.resource.data.customer.email is string;
      allow read, update, delete: if false;
    }
  }
}
